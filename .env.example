# Settings for docker-compose.yml. These values are for local development only: never use them in production.
# Copy to .env to change them. Every line is optional; the defaults match the dev profile.
# On a server set a strong MYSQL_ROOT_PASSWORD and MYSQL_DATA_DIR: docs/deploy-linux.md.
MYSQL_ROOT_PASSWORD=password
# Host port. Change it if another MySQL already uses 3306. The dev profile expects 3306.
MYSQL_PORT=3306
# Folder on this machine that holds the database files.
MYSQL_DATA_DIR=./data/mysql
