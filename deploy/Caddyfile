# Replace members.example.org with your domain.
# Caddy gets and renews Let's Encrypt certificates automatically and
# redirects HTTP to HTTPS.
# The app's defaults match this setup: COOKIE_SECURE=true (Secure cookies) and
# SERVER_ADDRESS=127.0.0.1 (listens on localhost only, so port 8080 is not
# reachable directly and X-Forwarded-* headers cannot be spoofed).
# Caddy overwrites a client-sent X-Forwarded-For with the real client address
# unless trusted_proxies is set: do not set it. The app trusts X-Forwarded-For
# only from loopback (TRUSTED_PROXIES), which is where Caddy connects from.

members.example.org {
	# Local network only (no public domain): remove the # on the next line so Caddy signs the certificate
	# itself. docs/deploy-linux.md explains how each device then trusts it.
	# tls internal

	encode gzip

	# The API takes small JSON bodies only
	request_body {
		max_size 1MB
	}

	reverse_proxy 127.0.0.1:8080

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		# Report-only for now. Fonts and icons are npm packages served by the app itself, so nothing
		# loads from a CDN any more. Enforce it (rename to Content-Security-Policy) after a check
		# that no page logs a violation.
		Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
	}
}
