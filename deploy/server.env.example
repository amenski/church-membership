# Settings for docker-compose.server.yml (MemberTracker and MySQL in Docker). Copy this file to
# .env next to docker-compose.server.yml, fill it in, then:
#   chmod 600 .env
#   docker compose -f docker-compose.server.yml up -d --build --wait
# Steps: docs/deploy-linux.md (Docker). Meaning of the app variables: docs/development.md#environment-variables
#
# Format (Docker Compose .env): one NAME=value per line, no spaces around =, no "export", a comment
# only on a line of its own. Put a value that has spaces, # or $ inside single quotes: NAME='a b#c$d'.
# The secrets below are meant to be hex or base64 text, which needs no quotes. Never commit the real file.
#
# The script deploy/backup-mysql.sh reads MYSQL_ROOT_PASSWORD from this file when it is at
# /opt/membertracker/.env; elsewhere, run it with ENV_FILE=/path/to/.env.

# ---- Required: compose refuses to start while one of these is empty ----

# Root password of MySQL. Used by the health check and the backup script, never by the app.
# Make one:  openssl rand -hex 24
# It applies only while the data folder is empty: changing it later does not change the database.
MYSQL_ROOT_PASSWORD=
# Password of the MySQL login the app uses (user DB_USERNAME, rights on felege_selam only).
# Make one:  openssl rand -hex 24
# Same rule: it is set when the data folder is created, so choose it before the first start.
DB_PASSWORD=
# Signs the login tokens, at least 32 characters. Changing it later signs everybody out.
# Make one:  openssl rand -base64 48
JWT_SECRET=

# ---- First start only ----

# Creates the first administrator while the users table is empty. Once you have signed in, DELETE the
# BOOTSTRAP_ADMIN_PASSWORD line and run `docker compose -f docker-compose.server.yml up -d` again.
# The password: 8 to 72 characters with an uppercase letter, a lowercase letter, a digit and a special
# character (put it in single quotes if it has a $, # or space). The app refuses to start with a weak one.
BOOTSTRAP_ADMIN_EMAIL=owner@example.org
BOOTSTRAP_ADMIN_PASSWORD=

# ---- Optional: delete the line (or leave it commented) to use the default ----

# Folder on the server that holds the database files (a bind mount, so the data survives the containers).
# Default /srv/membertracker/mysql; create it first: sudo mkdir -p /srv/membertracker/mysql
#MYSQL_DATA_DIR=/srv/membertracker/mysql
# The MySQL login the app uses. Default membertracker. Like the passwords, set before the first start.
#DB_USERNAME=membertracker
# true (default): session cookies are sent only over https, which a proxy with a certificate gives you.
# false: only for plain http on a network you trust, where it is the only way to sign in.
#COOKIE_SECURE=true
# Host port of the app, published on 127.0.0.1 only. Default 8080.
#APP_PORT=8080
# Memory limit of the app container. The Java heap is 75% of it. Default 768m.
#APP_MEM_LIMIT=768m
# Time zone of the monthly reminder jobs (6:00 and 9:00 on the 1st), for example Europe/Rome. Default UTC.
#TZ=UTC
# Regex of the peers allowed to set the client address through X-Forwarded-For. The default (in the
# compose file) trusts loopback and Docker's private ranges 172.16.0.0/12 and 192.168.0.0/16, which
# covers the proxy on this machine and proxies on Docker networks. Set it to your proxy's address if
# it is somewhere else, in single quotes: TRUSTED_PROXIES='10\.0\.0\.5'
#TRUSTED_PROXIES=
# Name of an existing Docker network that your reverse proxy is on. Only if you uncomment the proxy
# block at the end of docker-compose.server.yml.
#PROXY_NETWORK=proxy

# ---- Email (optional, but nothing is sent until these are right; see docs/email.md#configuration) ----
# Left out, the app's defaults apply: smtp.gmail.com:587 with STARTTLS and no username, so sending
# fails until you set at least MAIL_FROM, MAIL_USERNAME and MAIL_PASSWORD (a Gmail app password), or
# another server.
#MAIL_FROM=church@example.org
#MAIL_HOST=smtp.gmail.com
#MAIL_PORT=587
#MAIL_USERNAME=church@example.org
#MAIL_PASSWORD=
#MAIL_AUTH=true
#MAIL_STARTTLS=true
