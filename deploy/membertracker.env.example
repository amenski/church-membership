# Settings for the MemberTracker service. Copy to /opt/membertracker/membertracker.env, fill it in, then:
#   sudo chown membertracker:membertracker /opt/membertracker/membertracker.env
#   sudo chmod 600 /opt/membertracker/membertracker.env
# Steps: docs/deploy-linux.md. Meaning of each variable: docs/development.md#environment-variables
#
# Format (systemd EnvironmentFile): one NAME=value per line, no spaces around =, no "export", and a
# comment only on a line of its own (never after a value). Write a value that has spaces or # inside
# double quotes. Never commit the real file.

# ---- Required: the app does not start without these ----

# The MySQL login you create in docs/deploy-linux.md (never root).
DB_USERNAME=membertracker
# Password of that login. CHANGE_ME fails with "Access denied for user", on purpose.
DB_PASSWORD=CHANGE_ME
# Signs the login tokens. At least 32 characters; make it with: openssl rand -base64 48
# CHANGE_ME is shorter than 32 characters, so the app refuses to start until you replace it.
# Changing it later signs everybody out.
JWT_SECRET=CHANGE_ME

# ---- First start only ----

# Creates the first administrator while the users table is empty. Once you have signed in,
# DELETE the BOOTSTRAP_ADMIN_PASSWORD line and restart. 8 to 72 characters with an uppercase letter,
# a lowercase letter, a digit and a special character.
BOOTSTRAP_ADMIN_EMAIL=owner@example.org
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME

# ---- Optional: delete the line to use the default ----

# true (default): cookies are sent only over https, which is what Caddy gives you.
# false: only for plain http on a trusted network, where it is the only way to sign in.
COOKIE_SECURE=true
# 127.0.0.1 (default): only Caddy on this machine can reach the app. Use 0.0.0.0 only for plain http
# without Caddy (people then open http://<this machine>:8080).
#SERVER_ADDRESS=127.0.0.1
# Where MySQL is. Default (right for docker-compose.yml): jdbc:mysql://localhost:3306/felege_selam?serverTimezone=UTC
#DB_URL=jdbc:mysql://localhost:3306/felege_selam?serverTimezone=UTC

# ---- Email (optional, but nothing is sent until these are right; see docs/email.md#configuration) ----
# The defaults point at smtp.gmail.com:587 with STARTTLS and no username, so sending fails until you
# set at least MAIL_FROM, MAIL_USERNAME and MAIL_PASSWORD (a Gmail app password), or another server.
#MAIL_FROM=church@example.org
#MAIL_HOST=smtp.gmail.com
#MAIL_PORT=587
#MAIL_USERNAME=church@example.org
#MAIL_PASSWORD=CHANGE_ME
#MAIL_AUTH=true
#MAIL_STARTTLS=true

# Other settings (cookie lifetime, SameSite, trusted proxies, mail retries) are in
# docs/authentication.md#configuration and docs/email.md#configuration; the defaults are right here.
